# WPS integration settings. Copy to config/wps.env (or pass with --env-file) and set the secrets.
# bin/install.sh writes them to $sugar_config['wps'] in config_override.php of the CRM.
# Variables already set in the environment win over this file.

# master switch: false = no events are published (the /api/v9 endpoint still works)
WPS_ENABLED=true

# Redis Stream of WPS (service "redis-stream" of the WPS docker-compose). The CRM must reach it over the network.
WPS_REDIS_HOST=redis-stream
WPS_REDIS_PORT=6379
WPS_REDIS_PASSWORD=
# connect + read timeout of the after_save hook, seconds (a save waits at most this long if Redis is down)
WPS_REDIS_TIMEOUT=1.0
WPS_REDIS_STREAM=crm_events
# XADD MAXLEN ~ (0 = unlimited)
WPS_REDIS_STREAM_MAXLEN=100000

# modules whose after_save is published to the stream (comma list; empty = all modules)
WPS_EVENT_MODULES=Leads,Contacts,Accounts,Opportunities,Cases,Calls,Tasks,Meetings

# key of the /api/v9 endpoint: X-Auth-Key = WPS_API_STATIC_KEY . gmdate("Y.m.d H").
# Must equal CRM_API_STATIC_KEY of the WPS backend. Use a long random string.
WPS_API_STATIC_KEY=change-me
# CRM user the /api/v9 endpoint acts as (created_by / modified_user_id; 1 = admin)
WPS_API_USER_ID=1
